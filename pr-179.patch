+→ from backend.node_engine.workflow_manager import WorkflowManager
+
+# Advanced Core → Node Engine
+from src.core.advanced_workflow_engine import WorkflowManager as AdvancedWorkflowManager
+→ from backend.node_engine.workflow_manager import WorkflowManager
+```
