+    requests_per_second=2     # Reduce from default 5
+)
+
+collector = GmailDataCollector(rate_limit_config=config)
+
+# Wait for quota reset
+import time
+time.sleep(3600)  # Wait 1 hour for quota reset
+```
+
+#### Cache Corruption
