+    async def __aexit__(self, exc_type, exc_val, exc_tb):
+        """Ensure proper cleanup."""
+        await self.shutdown()
+
+    # Logging standards
+    def log_operation(self, operation: str, details: dict):
+        """Consistent logging format."""
+        self.logger.info(f"Plugin operation: {operation}", extra={
