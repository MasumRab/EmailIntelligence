+       def cleanup(self):
+           """Explicitly cleanup all managed processes."""
+           logger.info("Performing explicit resource cleanup...")
+           for p in self.processes[:]:  # Create a copy to iterate over
+               if p.poll() is None:
+                   logger.info(f"Terminating process {p.pid}...")
